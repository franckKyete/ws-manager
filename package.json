{
  "name": "ws-manager",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format:md": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\""
  },
  "lint-staged": {
    "*.rs": [
      "rustfmt --edition 2021"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2"
  }
}
